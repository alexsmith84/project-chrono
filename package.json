    "eslint": "^9.37.0",
    "eslint-plugin-svelte": "^3.12.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-eslint-parser": "^1.4.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
